# ---------------------------------------------------------------------------
# U APP server configuration. Copy to .env and set real values in your host.
# Never commit secrets. Firebase client config is public; Admin keys are not.
# ---------------------------------------------------------------------------

# Public application URL (used for signed links, QR codes and email links)
APP_URL=xa.com

# Firebase client configuration (safe for browsers)
VITE_FIREBASE_API_KEY=AIzaSyBW-ouFRYPCYM-UnZyBE41D3-uFlaarGbc
VITE_FIREBASE_AUTH_DOMAIN=dmakenow.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://dmakenow-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=dmakenow
VITE_FIREBASE_STORAGE_BUCKET=dmakenow.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=388458456292
VITE_FIREBASE_APP_ID=1:388458456292:web:5579319a0e6206e0b478f1

# Firebase Admin (server only — never expose to the browser)
FIREBASE_PROJECT_ID=dmakenow
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email API (called from the server only)
OTP_API_BASE=https://otpapi-seven.vercel.app
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
SUPPORT_EMAIL=akshay123fagg@gmail.com

# ---------------------------------------------------------------------------
# Platform APK build service. Configure ONCE by the platform owner.
# Users never provide a GitHub account or token.
# The platform's own GitHub Actions account builds every user's APK/AAB.
# ---------------------------------------------------------------------------
VITE_UAPP_GH_OWNER=Akshayapis
VITE_UAPP_GH_REPO=sasuki
VITE_UAPP_GH_WORKFLOW=android-build.yml
VITE_UAPP_GH_REF=main
VITE_UAPP_GH_TOKEN=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

# Optional private REST backend for the U APP public developer API
VITE_UAPP_API_BASE=

# Temporary artifact delivery
UPLOAD_DIR=/var/uapp/builds
DOWNLOAD_TTL_SECONDS=540
MAX_UPLOAD_MB=400

# Manual UPI payments — administrator supplied, do not invent a real UPI ID
UPI_MERCHANT_ID=
UPI_PAYEE_NAME=

# API hardening
API_KEY_PEPPER=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Merchant UPI for the payment QR (owner supplied, real value only)
VITE_UAPP_UPI_ID=
VITE_UAPP_UPI_NAME=
